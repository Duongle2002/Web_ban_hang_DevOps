# Vite environment variables for bank transfer QR
# Copy this file to .env.local and fill in your bank info

# VietQR bank code (slug). Examples: vcb (Vietcombank), mb (MBBank), tpb (TPBank), bidv, vietinbank...
VITE_BANK_CODE = mb

# Account number (digits only, without spaces)
VITE_BANK_ACCOUNT = 7222208062002

# Account holder name (uppercase, as registered at the bank)
VITE_BANK_NAME = LE HUU DUONG

# Optional: VietQR image template. Options: compact, compact2, mini, compact-black, etc.
VITE_VIETQR_TEMPLATE = compact2

# Optional: Additional info (invoice code, order note). Will be URL-encoded.
VITE_VIETQR_ADDINFO = Thanh toan don hang

# Currency settings
# Default currency for display: USD or VND
VITE_DEFAULT_CURRENCY = USD
# Exchange rate VND per 1 USD (integer recommended for QR amount). Example: 25000
VITE_EXCHANGE_RATE_VND_PER_USD = 25000